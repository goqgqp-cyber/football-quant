{
    "name": "football-quant",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Web app phân tích kèo bóng đá (Poisson/Dixon-Coles + Gemini). Tiếng Việt, mobile-first.",
    "scripts": {
        "dev": "vite",
        "dev:api": "tsx watch server/index.ts",
        "dev:all": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev\"",
        "build": "tsc -b && vite build && npm run build:api",
        "build:api": "node scripts/build-api.mjs",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "smoke": "tsx scripts/smoke-vercel.ts",
        "smoke:auth": "tsx scripts/smoke-auth.ts",
        "smoke:vercel": "tsx scripts/smoke-vercel.ts",
        "seed:admin": "tsx scripts/seed-admin.ts",
        "start:api": "tsx server/index.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.4",
        "@upstash/redis": "^1.39.0",
        "bcryptjs": "^3.0.3",
        "framer-motion": "^11.11.9",
        "hono": "^4.13.13",
        "jose": "^6.2.12",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "concurrently": "^10.0.6",
        "esbuild": "^0.24.0",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.6.3",
        "vite": "^6.0.0",
        "vitest": "^2.1.4"
    }
}