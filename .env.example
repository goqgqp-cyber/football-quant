# ============================================================
# Football Quant — biến môi trường (KHÔNG commit file .env thật)
# Sao chép file này thành .env rồi điền giá trị thật.
# ============================================================

# --- Gemini (Google AI Studio) ---
# Chỉ dùng ở BACKEND. KHÔNG bao giờ nhúng vào frontend/bundle.
# Dán key bằng nút "Copy key" trong AI Studio (không copy từ ảnh chụp).
# GEMINI_MODEL: dùng alias "gemini-flash-latest" (đã kiểm chứng chạy được)
# hoặc ID model chính xác từ nút "Copy cURL quickstart" trong AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Xác thực ---
# Chuỗi ngẫu nhiên dài >= 32 ký tự
JWT_SECRET=
# Chỉ tài khoản này được tạo khi tắt đăng ký công khai
ADMIN_EMAIL=

# Cho phép đăng ký công khai? true/false (mặc định false)
ALLOW_PUBLIC_SIGNUP=false

# --- Tùy chọn ---
# true = lưu ảnh gốc vào object storage (GCS/R2/Vercel Blob), mặc định false
STORE_ORIGINAL_IMAGES=false

# --- Dev frontend (tùy chọn) ---
# Địa chỉ backend khi chạy `npm run dev`
VITE_DEV_API_TARGET=http://localhost:8787

# --- SportAPI (RapidAPI) ---
SPORTAPI_BASE_URL=https://sportapi7.p.rapidapi.com/api/v1
SPORTAPI_HOST=sportapi7.p.rapidapi.com
SPORTAPI_KEY=2d1fc18ae1msh5e85b0a87523e04p1ffed5jsnd7b67c197803

