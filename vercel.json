{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/[...route].js": {
            "maxDuration": 60
        },
        "api/index.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/[...route]"
        },
        {
            "source": "/api",
            "destination": "/api/[...route]"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
